# LavaSeguro — variáveis de ambiente (exemplo)
# Copie para .env e preencha. NÃO versionar o .env real.

# --- Postgres ---
POSTGRES_USER=lavaseguro
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=lavaseguro
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lavaseguro:troque_esta_senha@db:5432/lavaseguro

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Segredo só para assinar tokens futuros (fase 2 JWT). MVP usa PIN do dia.
APP_SECRET=troque_por_um_segredo_longo
# Cobrança plugável — o cliente escolhe banco/adquirente. MVP: manual.
# Exemplos futuros: stone, cielo, pagseguro, banco_do_cliente (sem vendor fixo).
PAYMENT_PROVIDER=manual

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# --- Produção (referência; preencher só na VPS) ---
# DOMAIN=lavaseguro.tech42.com.br
# CADDY_EMAIL=ops@tech42.com.br
